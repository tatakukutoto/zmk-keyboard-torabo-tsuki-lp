#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        c_lclk {
            bindings = <&mkp LCLK>;
            key-positions = <16 17>;
            layers = <0>;
            timeout-ms = <200>;
        };

        c_rclk {
            bindings = <&mkp RCLK>;
            key-positions = <18 17>;
            layers = <0>;
            timeout-ms = <200>;
        };

        c_mclk {
            bindings = <&mkp MCLK>;
            key-positions = <16 17 18>;
            timeout-ms = <200>;
            layers = <0>;
        };

        c_Ro {
            bindings = <&kp INT_RO>;
            key-positions = <31 30>;
            timeout-ms = <200>;
            layers = <0>;
        };
    };

    macros {
        win_open: win_open {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL &kp LEFT_ALT &kp DELETE>,
                <&macro_release>,
                <&kp LEFT_CONTROL &kp LEFT_ALT &kp DELETE>;

            label = "WIN_OPEN";
        };

        win_lock: win_lock {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_GUI &kp L>,
                <&macro_release>,
                <&kp LEFT_GUI &kp L>;

            label = "WIN_LOCK";
        };

        macro_9981: macro_9981 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N9 &kp N9 &kp N8 &kp N1>;
            label = "MACRO_9981";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp Q                    &kp W         &kp E         &kp R             &kp T                                                    &kp Y      &kp U  &kp I      &kp O     &kp P
&kp A                    &kp S         &kp D         &kp F             &kp G                                                    &kp H      &kp J  &lt 6 K    &lt 5 L   &kp MINUS
&kp Z                    &kp X         &kp C         &kp V             &kp B             &kp LS(N8)                &kp LS(N9)   &kp N      &kp M  &kp COMMA  &kp DOT   &kp FSLH
&mt LEFT_CONTROL ESCAPE  &kp LEFT_GUI  &kp LEFT_ALT  &lt 4 LANGUAGE_2  &lt 3 LANGUAGE_1  &mt LEFT_SHIFT SPACE      &lt 2 ENTER  &lt 1 TAB  &none  &none      &kp BSPC  &kp DEL
            >;
        };

        layer_1 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                          &trans            &trans            &kp RIGHT_BRACKET  &kp EQUAL      &kp INT_YEN
&trans  &trans  &trans  &trans  &trans                          &trans            &kp LS(N7)        &kp LS(NUMBER_2)   &kp SEMICOLON  &kp SQT
&trans  &trans  &trans  &trans  &trans  &kp RBKT      &kp BSLH  &kp LS(NUMBER_1)  &kp LS(NUMBER_3)  &kp LS(NUMBER_4)   &kp LS(N5)     &kp LS(NUMBER_6)
&trans  &trans  &trans  &trans  &trans  &trans        &trans    &trans            &trans            &trans             &trans         &trans
            >;
        };

        layer_2 {
            bindings = <
&kp N1             &kp N2     &kp N3       &kp N4     &kp N5                             &kp N6    &kp N7    &kp N8        &kp N9     &kp N0
&kp LS(SEMICOLON)  &kp MINUS  &kp LS(SQT)  &kp SLASH  &kp LS(MINUS)                      &kp LEFT  &kp DOWN  &kp UP_ARROW  &kp RIGHT  &kp F2
&trans             &trans     &trans       &trans     &trans         &trans      &trans  &trans    &trans    &trans        &trans     &trans
&trans             &trans     &trans       &trans     &trans         &trans      &trans  &trans    &trans    &trans        &trans     &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans     &trans                              &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans                              &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &win_lock  &win_open  &macro_9981      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans     &trans           &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_4 {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                        &trans  &trans  &trans  &trans  &trans
&trans        &trans        &trans        &bt BT_CLR    &bt BT_CLR_ALL                      &trans  &trans  &trans  &trans  &trans
&trans        &trans        &trans        &trans        &trans          &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans        &trans        &trans        &trans        &trans          &trans      &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
