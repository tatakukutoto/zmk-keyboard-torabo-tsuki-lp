#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    tapping-term-ms = <500>;
};

&lt {
    flavor = "balanced";
    tapping-term-ms = <500>;
};

/ {
    combos {
        compatible = "zmk,combos";

        c_lclk {
            bindings = <&mkp LCLK>;
            key-positions = <16 17>;
            layers = <0 1>;
        };

        c_rclk {
            bindings = <&mkp RCLK>;
            key-positions = <18 17>;
            layers = <0 1>;
        };

        c_mclk {
            bindings = <&mkp MCLK>;
            key-positions = <16 17 18>;
            layers = <0 1>;
        };

        c_lbrkt_jis {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <24 25>;
            layers = <0 1>;
        };

        c_rbrkt_jis {
            bindings = <&kp BACKSLASH>;
            key-positions = <26 27>;
            layers = <0 1>;
        };

        c_minus_jis {
            bindings = <&kp MINUS>;
            key-positions = <6 7>;
            layers = <0 1>;
        };

        c_hat_jis {
            bindings = <&kp EQUAL>;
            key-positions = <8 7>;
            layers = <0 1>;
        };

        c_yen_jis {
            bindings = <&kp INTERNATIONAL_3>;
            key-positions = <8 9>;
            layers = <0 1>;
        };

        c_atmk_jis {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <18 19>;
            layers = <0 1>;
        };

        c_Ro_jis {
            bindings = <&kp INT_RO>;
            key-positions = <31 30>;
            layers = <0 1>;
        };
    };

    macros {
        macro_9981: macro_9981 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N9 &kp N9 &kp N8 &kp N1 &kp ENTER>;
            label = "MACRO_9981";
        };

        macro_99819981: macro_99819981 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N9 &kp N9 &kp N8 &kp N1 &kp N9 &kp N9 &kp N8 &kp N1>;
            label = "MACRO_99819981";
        };

        bt0: bt0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0 &to 0>;
            label = "BT0";
        };

        bt1: bt1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1 &to 1>;
            label = "BT1";
        };

        bt2: bt2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2 &to 1>;
            label = "BT2";
        };

        bt3: bt3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 3 &to 1>;
            label = "BT3";
        };

        bt4: bt4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 4 &to 1>;
            label = "BT4";
        };
    };

    behaviors {
        kp_semicolon_us: kp_semicolon_us {
            compatible = "zmk,behavior-mod-morph";
            label = "KP_SEMICOLON_US";
            bindings = <&kp SEMICOLON>, <&kp SQT>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_plus_minus: mm_plus_minus {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_PLUS_MINUS";
            bindings = <&kp LS(SEMICOLON)>, <&kp MINUS>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_ast_sla: mm_ast_sla {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_AST_SLA";
            bindings = <&kp LS(SQT)>, <&kp SLASH>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_period_equal: mm_period_equal {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_PERIOD_EQUAL";
            bindings = <&kp PERIOD>, <&kp LS(MINUS)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        mac_base {
            bindings = <
&kp Q                    &kp W           &kp E         &kp R             &kp T                                                    &kp Y      &kp U  &kp I      &kp O          &kp P
&mt LEFT_GUI A           &mt LEFT_GUI S  &kp D         &kp F             &kp G                                                    &kp H      &kp J  &kp K      &lt 7 L        &kp_semicolon_us
&kp Z                    &kp X           &kp C         &kp V             &kp B             &kp LS(N8)                &kp LS(N9)   &kp N      &kp M  &kp COMMA  &kp DOT        &kp FSLH
&mt LEFT_CONTROL ESCAPE  &kp LEFT_ALT    &kp LEFT_GUI  &lt 4 LANGUAGE_2  &lt 3 LANGUAGE_1  &mt LEFT_SHIFT SPACE      &lt 5 ENTER  &lt 2 TAB  &none  &none      &kp BACKSPACE  &kp DELETE
            >;
        };

        win_base {
            bindings = <
&trans       &trans       &trans  &trans  &trans                           &trans  &trans  &trans  &trans  &trans
&mt LCTRL A  &mt LCTRL S  &trans  &trans  &trans                           &trans  &trans  &trans  &trans  &trans
&trans       &trans       &trans  &trans  &trans  &trans      &trans       &trans  &trans  &trans  &trans  &trans
&trans       &trans       &trans  &trans  &trans  &trans      &lt 6 ENTER  &trans  &trans  &trans  &trans  &trans
            >;
        };

        num {
            bindings = <
&kp F1   &kp F2   &kp F3  &kp F4  &kp F5                       &mm_ast_sla       &kp N7        &kp N8        &kp N9        &kp N0
&kp F6   &kp F7   &kp F8  &kp F9  &kp F10                      &mm_plus_minus    &kp NUMBER_4  &kp N5        &kp NUMBER_6  &none
&kp F11  &kp F12  &none   &none   &none    &none       &none   &mm_period_equal  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &none
&trans   &trans   &trans  &trans  &trans   &trans      &trans  &trans            &trans        &trans        &trans        &trans
            >;
        };

        sign {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &kp LS(N7)        &kp LS(N8)        &kp LS(N9)        &trans
&trans  &trans  &trans  &trans  &trans                      &trans  &kp LS(N4)        &kp LS(N5)        &kp LS(NUMBER_6)  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &kp LS(NUMBER_1)  &kp LS(NUMBER_2)  &kp LS(N3)        &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans            &trans            &trans            &trans
            >;
        };

        etc {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans    &trans    &kp F2        &trans     &trans
&trans  &trans  &trans  &trans  &trans                      &kp LEFT  &kp DOWN  &kp UP_ARROW  &kp RIGHT  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans    &trans    &trans        &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans    &trans    &trans        &trans     &trans
            >;
        };

        mac_macro {
            bindings = <
&trans  &trans  &trans  &trans  &trans                           &trans              &trans              &trans            &trans         &trans
&trans  &trans  &trans  &trans  &trans                           &kp LC(LEFT_ARROW)  &kp LC(DOWN)        &kp LC(UP_ARROW)  &kp LC(RIGHT)  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &macro_9981  &kp LG(LEFT)        &kp LG(DOWN_ARROW)  &kp LG(UP_ARROW)  &kp LG(RIGHT)  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans       &trans              &trans              &trans            &trans         &trans
            >;
        };

        win_macro {
            bindings = <
&trans  &trans  &trans  &trans  &trans                               &trans            &trans     &trans       &trans             &trans
&trans  &trans  &trans  &trans  &trans                               &kp LC(LG(LEFT))  &kp LG(Z)  &kp LG(TAB)  &kp LC(LG(RIGHT))  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &macro_99819981  &kp LA(LC(DEL))   &kp LG(L)  &trans       &trans             &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans           &trans            &trans     &trans       &trans             &trans
            >;
        };

        sucroller {
            bindings = <
&none      &none         &none           &none         &none                    &none  &none      &none              &none  &none
&kp LCTRL  &kp LEFT_ALT  &kp LEFT_SHIFT  &kp LEFT_GUI  &none                    &none  &kp MINUS  &kp LS(SEMICOLON)  &none  &none
&none      &none         &none           &none         &none  &none      &none  &none  &none      &none              &none  &none
&none      &none         &none           &none         &none  &none      &none  &none  &none      &none              &none  &none
            >;
        };

        setting {
            bindings = <
&bt0    &bt1    &bt2    &bt3        &bt4                                &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &bt BT_CLR  &bt BT_CLR_ALL                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans      &trans          &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans      &trans          &trans      &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        setting_mac {
            if-layers = <2 3>;
            then-layer = <8>;
        };

        setting_win {
            if-layers = <2 3>;
            then-layer = <8>;
        };
    };
};
