#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
            layers = <1>;
        };

        lclk {
            bindings = <&mkp LCLK>;
            key-positions = <33 34>;
            layers = <0>;
        };

        rclk {
            bindings = <&mkp RCLK>;
            key-positions = <34 35>;
            layers = <0>;
        };
    };

    behaviors {
        lmt: lmt {
            compatible = "zmk,behavior-hold-tap";
            label = "Layer/Mouce Tap";
            bindings = <&mo>, <&mkp>;

            #binding-cells = <2>;
            tapping-term-ms = <50>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&none  &none             &none         &none     &none             &none                                                     &none      &none  &none      &none          &none       &none
&none  &kp Q             &kp W         &kp E     &kp R             &kp T                                                     &kp Y      &kp U  &kp I      &kp O          &kp P       &none
&none  &kp A             &kp S         &kp D     &kp F             &kp G             &none                 &none             &kp H      &kp J  &kp K      &kp L          &kp MINUS   &none
&none  &kp Z             &kp X         &kp C     &kp V             &kp B             &kp LS(NUMBER_8)      &kp LS(NUMBER_9)  &kp N      &kp M  &kp COMMA  &kp DOT        &kp SLASH   &none
&none  &mt LCTRL ESCAPE  &kt LEFT_GUI  &kp LALT  &lt 4 LANGUAGE_2  &lt 3 LANGUAGE_1  &mt LEFT_SHIFT SPACE  &lt 2 ENTER       &lt 1 TAB  &none  &none      &kp BACKSPACE  &kp DELETE  &none
            >;
        };

        layer_1 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                                    &trans  &trans  &trans            &trans         &trans       &trans
&trans  &trans  &trans  &trans  &trans  &trans                                    &trans  &trans  &kp LEFT_BRACKET  &kp EQUAL      &kp INT_YEN  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans             &trans         &trans  &trans  &trans            &kp SEMICOLON  &kp SQT      &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp RIGHT_BRACKET  &kp BACKSLASH  &trans  &trans  &trans            &trans         &kp INT_RO   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans             &trans         &trans  &trans  &trans            &trans         &trans       &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans             &trans        &trans        &trans        &trans                         &trans        &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1       &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5                   &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0  &trans
&trans  &kp LS(SEMICOLON)  &kp MINUS     &kp LS(SQT)   &kp SLASH     &kp LS(MINUS)  &trans  &trans  &trans        &mkp LCLK     &mkp MCLK     &mkp RCLK     &trans        &trans
&trans  &trans             &trans        &trans        &trans        &trans         &trans  &trans  &trans        &trans        &trans        &trans        &trans        &trans
&trans  &trans             &trans        &trans        &trans        &trans         &trans  &trans  &trans        &trans        &trans        &trans        &trans        &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
