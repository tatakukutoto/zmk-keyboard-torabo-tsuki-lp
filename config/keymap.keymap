#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        c_lclk {
            bindings = <&mkp LCLK>;
            key-positions = <16 17>;
            layers = <0 1>;
            timeout-ms = <200>;
        };

        c_rclk {
            bindings = <&mkp RCLK>;
            key-positions = <18 17>;
            layers = <0 1>;
            timeout-ms = <200>;
        };

        c_mclk {
            bindings = <&mkp MCLK>;
            key-positions = <16 17 18>;
            timeout-ms = <200>;
            layers = <0 1>;
        };

        c_Ro {
            bindings = <&kp INT_RO>;
            key-positions = <31 30>;
            timeout-ms = <200>;
            layers = <0 1>;
        };
    };

    macros {
        win_open: win_open {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL &kp LEFT_ALT &kp DELETE>,
                <&macro_release>,
                <&kp LEFT_CONTROL &kp LEFT_ALT &kp DELETE>;

            label = "WIN_OPEN";
        };

        win_lock: win_lock {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_GUI &kp L>,
                <&macro_release>,
                <&kp LEFT_GUI &kp L>;

            label = "WIN_LOCK";
        };

        macro_9981: macro_9981 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N9 &kp N9 &kp N8 &kp N1 &kp N9 &kp N9 &kp N8 &kp N1>;
            label = "MACRO_9981";
        };

        bt0: bt0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0 &to 0>;
            label = "BT0";
        };

        bt1: bt1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1 &to 1>;
            label = "BT1";
        };

        bt2: bt2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2 &to 1>;
            label = "BT2";
        };

        bt3: bt3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 3 &to 1>;
            label = "BT3";
        };

        bt4: bt4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 4 &to 1>;
            label = "BT4";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&kp Q                    &kp W         &kp E         &kp R             &kp T                                                    &kp Y      &kp U  &kp I      &kp O     &kp P
&kp A                    &kp S         &kp D         &kp F             &kp G                                                    &kp H      &kp J  &lt 8 K    &lt 7 L   &kp MINUS
&kp Z                    &kp X         &kp C         &kp V             &kp B             &kp LS(N8)                &kp LS(N9)   &kp N      &kp M  &kp COMMA  &kp DOT   &kp FSLH
&mt LEFT_CONTROL ESCAPE  &kp LEFT_GUI  &kp LEFT_ALT  &lt 6 LANGUAGE_2  &lt 4 LANGUAGE_1  &mt LEFT_SHIFT SPACE      &lt 3 ENTER  &lt 2 TAB  &none  &none      &kp BSPC  &kp DEL
            >;
        };

        win_base {
            bindings = <
&kp Q                    &kp W         &kp E         &kp R             &kp T                                                    &kp Y      &kp U  &kp I      &kp O     &kp P
&kp A                    &kp S         &kp D         &kp F             &kp G                                                    &kp H      &kp J  &lt 8 K    &lt 7 L   &kp MINUS
&kp Z                    &kp X         &kp C         &kp V             &kp B             &kp LS(N8)                &kp LS(N9)   &kp N      &kp M  &kp COMMA  &kp DOT   &kp FSLH
&mt LEFT_CONTROL ESCAPE  &kp LEFT_GUI  &kp LEFT_ALT  &lt 6 LANGUAGE_2  &lt 5 LANGUAGE_1  &mt LEFT_SHIFT SPACE      &lt 3 ENTER  &lt 2 TAB  &none  &none      &kp BSPC  &kp DEL
            >;
        };

        sign {
            bindings = <
&trans  &trans  &trans  &trans  &trans                          &trans            &trans            &kp LEFT_BRACKET  &kp EQUAL      &kp INT_YEN
&trans  &trans  &trans  &trans  &trans                          &trans            &kp LS(N7)        &kp LS(NUMBER_2)  &kp SEMICOLON  &kp SQT
&trans  &trans  &trans  &trans  &trans  &kp RBKT      &kp BSLH  &kp LS(NUMBER_1)  &kp LS(NUMBER_3)  &kp LS(NUMBER_4)  &kp LS(N5)     &kp LS(NUMBER_6)
&trans  &trans  &trans  &trans  &trans  &trans        &trans    &trans            &trans            &trans            &trans         &trans
            >;
        };

        num {
            bindings = <
&kp N1             &kp N2     &kp N3       &kp N4     &kp N5                             &kp N6    &kp N7    &kp N8        &kp N9     &kp N0
&kp LS(SEMICOLON)  &kp MINUS  &kp LS(SQT)  &kp SLASH  &kp LS(MINUS)                      &kp LEFT  &kp DOWN  &kp UP_ARROW  &kp RIGHT  &kp F2
&trans             &trans     &trans       &trans     &trans         &trans      &trans  &trans    &trans    &trans        &trans     &trans
&trans             &trans     &trans       &trans     &trans         &trans      &trans  &trans    &trans    &trans        &trans     &trans
            >;
        };

        macro {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans              &trans              &trans            &trans         &trans
&trans  &trans  &trans  &trans  &trans                      &kp LC(LEFT_ARROW)  &kp LC(DOWN)        &kp LC(UP_ARROW)  &kp LC(RIGHT)  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &kp LG(LEFT)        &kp LG(DOWN_ARROW)  &kp LG(UP_ARROW)  &kp LG(RIGHT)  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans              &trans              &trans            &trans         &trans
            >;
        };

        win_macro {
            bindings = <
&trans  &trans  &trans  &trans     &trans                              &trans              &trans              &trans            &trans             &trans
&trans  &trans  &trans  &trans     &trans                              &kp LC(LG(LEFT))    &kp LG(TAB)         &kp LA(TAB)       &kp LC(LG(RIGHT))  &trans
&trans  &trans  &trans  &win_lock  &win_open  &macro_9981      &trans  &kp LG(LEFT_ARROW)  &kp LG(DOWN_ARROW)  &kp LG(UP_ARROW)  &kp LG(RIGHT)      &trans
&trans  &trans  &trans  &trans     &trans     &trans           &trans  &trans              &trans              &trans            &trans             &trans
            >;
        };

        bt_sel {
            bindings = <
&bt0    &bt1    &bt2    &bt3        &bt4                                &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &bt BT_CLR  &bt BT_CLR_ALL                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans      &trans          &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans      &trans          &trans      &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        sucroller {
            bindings = <
&none  &none  &none  &none  &none                    &none  &none  &none             &none  &none
&none  &none  &none  &none  &none                    &none  &none  &kp LEFT_CONTROL  &none  &none
&none  &none  &none  &none  &none  &none      &none  &none  &none  &none             &none  &none
&none  &none  &none  &none  &none  &none      &none  &none  &none  &none             &none  &none
            >;
        };

        precision {
            bindings = <
&none  &none  &none  &none  &none                    &none  &none      &none  &none      &none
&none  &none  &none  &none  &none                    &none  &mkp LCLK  &none  &mkp RCLK  &none
&none  &none  &none  &none  &none  &none      &none  &none  &none      &none  &none      &none
&none  &none  &none  &none  &none  &none      &none  &none  &none      &none  &none      &none
            >;
        };
    };
};
